# Opsional konfigurasi untuk run-esp.sh
# Salin file ini menjadi .esp.env dan sesuaikan bila perlu.
# Format: VARIABEL=nilai (satu per baris).

# Port serial ESP32. Bila dikosongkan, dideteksi otomatis dari /dev/ttyUSB* / /dev/ttyACM*.
# Contoh:
# ESP_PORT=/dev/ttyUSB0

# Target chip. Bila dikosongkan, diambil dari sdkconfig (default: esp32).
# Contoh:
# ESP_TARGET=esp32
